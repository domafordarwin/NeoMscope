# NeoMscope Raspberry Pi deployment config.
#
# Copy this file to tools/pi-config.env and edit the values for your Pi.
# tools/pi-config.env is gitignored (your secrets, your IP).
#
#     cp tools/pi-config.example.env tools/pi-config.env
#     # then edit tools/pi-config.env

# Pi network address — IP or hostname (mDNS .local works if avahi is up)
PI_HOST=192.168.123.110

# SSH user. Pi OS Bookworm doesn't have a default user anymore — set this to
# whatever you created during Pi imager setup.
PI_USER=pi

# Optional non-default SSH port
PI_PORT=22

# Where to put the project on the Pi (relative to PI_USER's home)
PI_PROJECT_DIR=NeoMscope

# Public Git remote — used by deploy_to_pi.ps1 if Pi side has no clone yet
GIT_REMOTE=https://github.com/domafordarwin/NeoMscope.git
GIT_BRANCH=main

# Pass through to setup.sh on the Pi side. Common combos:
#   --no-gui       → install CLI only (saves ~200 MB)
#   --no-hailo     → useful when iterating on a Pi that's not connected to the AI HAT+ 2 yet
#   --no-self-test → skip hailortcli probe at the end
SETUP_FLAGS=
