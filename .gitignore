# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/

# Model weights (too large for GitHub - track via Git LFS or external storage)
weights/*.h5
weights/*.pth
weights/*.weights
weights/*.pt
*.h5

# Detection result outputs (regenerated)
detection_results_captured/*
detection_results_live/*
!detection_results_captured/.gitkeep
!detection_results_live/.gitkeep

# Windows / macOS metadata
desktop.ini
.DS_Store
Thumbs.db

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# Environment / secrets
.env
.env.local
.env.*.local

# Claude Code local overrides (keep .claude/settings.json shared)
.claude/settings.local.json
.claude/.credentials*
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json

# Logs
*.log
logs/

# Datasets (large, generated, or downloaded)
datasets/onioncell/
datasets/*/images/
datasets/*/labels/
!datasets/.gitkeep

# Raw microscope images (~3.2GB, 34-40MB per file — far exceeds GitHub limits)
# Original location: raws/JPEG_Export_Data/ (105 files, 2020-10-07 capture session)
# For training: downscaled subset is generated into datasets/onioncell/images/
raws/

# Model artifacts (large; generated)
models/pt/*.pt
models/onnx/*.onnx
models/hef/*.hef
!models/pt/.gitkeep
!models/onnx/.gitkeep
!models/hef/.gitkeep

# Training run outputs
runs/
*.pt
!yolo*.pt.lock

# Legacy environment
.legacy-venv/
.venv/

# Hailo deployment artifacts (large, license-restricted by Hailo)
pi5-deploy/*.deb
pi5-deploy/*.whl
pi5-deploy/*.zip
pi5-deploy/*.tar.gz

# Per-developer Pi connection settings (IP/user/keys)
tools/pi-config.env

# OS
$RECYCLE.BIN/
