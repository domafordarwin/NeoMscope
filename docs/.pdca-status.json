      "decisions": {
        "model": "YOLOv11-det",
        "backupModel": "YOLOv8-det",
        "modelSize": "YOLOv11s (1차), YOLOv11m (mAP 부족시 업그레이드)",
        "hardware": "Raspberry Pi 5 + AI HAT+ 2 (Hailo-10H, 40 TOPS INT4 / 20 TOPS INT8, 8GB LPDDR4X)",
        "hailoToolchain": "Model Zoo master branch + Hailo Dataflow Compiler 4.x+ (WSL2 Ubuntu)",
        "trainingEnv": "Kaggle (T4/P100 16GB VRAM, 30h/week free)",
        "developmentPC": "Windows 11 + Quadro P2000 4GB (학습 부족, 코드 개발/ONNX/HEF용)",
        "outputFormat": "bbox detection (5 division stages, no polygon mask)",
        "labelStrategy": "bootstrap from existing Mask R-CNN model",
        "dataLocation": "raws/JPEG_Export_Data (105) + captured_raw_images (22) = 127 images",
        "rationale": {
          "det_over_seg": "기존 Mask R-CNN이 polygon이 아닌 bbox로 학습됨 (dataset_config.py:88-94)",
          "kaggle_over_local": "현 PC GPU(Quadro P2000 4GB) YOLO seg/det 학습 부족",
          "bootstrap_over_manual": "원본 어노테이션 부재, 기존 모델 활용으로 0.5-1일 단축"
        }
      }
    },
